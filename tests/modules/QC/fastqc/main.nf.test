nextflow_process {

	name "Test Process fastqc"
	script "modules/QC/fastqc/main.nf"
	process "fastqc"

	test("FastQC HTML report of a single R1 FASTQ") {

		when {
			process {
				"""
				input[0] = file("$projectDir/data/SeraSeq/SeraSeq-part1.R1.fastq.gz")
				"""
			}
		}

		then {
			assert process.success
			assert snapshot(
				path(process.out.HTML.get(0)).text.replaceFirst('(<div id="header_filename">)[^<]+<br/>', '$1').md5()
			).match("SeraSeq-part1.R1_fastqc.html")
		}

	}

}
