nextflow_process {

	name "Test Process cutadapt"
	script "modules/cutadapt/main.nf"
	process "cutadapt"

	test("Paired-end cutadapt") {

		when {
			process {
				"""
				input[0] = [
					file("$projectDir/data/SeraSeq/SeraSeq-part1.R1.fastq.gz"),
					file("$projectDir/data/SeraSeq/SeraSeq-part1.R2.fastq.gz"),
					"SeraSeq-PE-part1",
					"SeraSeq-PE-part1_1",
					"paired"
				]
				input[1] = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
				input[2] = "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"
				"""
			}
		}

		then {
			assert process.success
			assert snapshot(process.out).match()
		}

	}
	
	test("Single-end cutadapt") {

		when {
			process {
				"""
				R2 = file("/tmp/SeraSeq-SE-part1_1_empty-R2")
				R2.text = ''
				
				input[0] = [
					file("$projectDir/data/SeraSeq/SeraSeq-part1.R1.fastq.gz"),
					R2,
					"SeraSeq-SE-part1",
					"SeraSeq-SE-part1_1",
					"single"
				]
				input[1] = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
				input[2] = "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"
				"""
			}
		}

		then {
			assert process.success
			assert snapshot(process.out).match()
		}

	}

}
